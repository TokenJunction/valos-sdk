{
  "name": "valos-sdk",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "description": "Public Valos connector SDK for validating connector manifests.",
  "type": "module",
  "engines": {
    "node": "22.23.4"
  },
  "packageManager": "npm@10.9.9",
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./schema/connector-manifest.schema.json": "./schema/connector-manifest.schema.json"
  },
  "files": [
    "src/",
    "schema/"
  ],
  "scripts": {
    "test": "c8 --all --check-coverage --statements=90 --branches=80 --lines=80 --functions=80 --include=src/**/*.js --exclude=test/** --reporter=text --reporter=text-summary -- node --test",
    "lint": "eslint . --max-warnings=0",
    "build": "node scripts/reproducible-build.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TokenJunction/valos-sdk.git"
  },
  "bugs": {
    "url": "https://github.com/TokenJunction/valos-sdk/issues"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "c8": "12.0.0",
    "eslint": "10.14.0"
  }
}
